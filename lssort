#!/usr/bin/env bash

# lssort lists files in a folder in a structured way, usually
# taking less space for the output than normal ls would.
#
# - list dirs starting with _ first
#   then dirs
#   then files
#   then symlinks and other stuff
#
# - lists files after folders like windoze explorer
#   now also possible with: ls --group-directories-first
#
# ## updates:
# ### fri 2026-11-06
# One find per folder, sorted into groups in bash, one ls per group.
#

LS=ls
for c in gls "/Users/$USER/opt/coreutils/libexec/gnubin/ls"; do
	command -v "$c" &>/dev/null && { LS=$c; break; }
done

# ls switches lssort passes on; they can be combined, e.g. -la
validswitches=(-X -l -r -t -C -F -1 -a -A -d -s -v -h -S)
validletters=$(IFS=; echo "${validswitches[*]//-/}")  # "XlrtCF1aAdsvhS"

switches=(-v)
dirs=()
others=()
showhidden=

for arg in "$@"; do
	if [[ -e $arg || -L $arg ]]; then  # an existing path wins over a switch
		if [[ -d $arg ]]; then dirs+=("$arg"); else others+=("$arg"); fi
	elif [[ $arg == -?* && ${arg:1} != *[!$validletters]* ]]; then
		switches+=("$arg")  # single or combined, e.g. -l or -la
		[[ $arg == -*[aA]* ]] && showhidden=1
	else
		others+=("$arg")    # let ls report it as missing
	fi
done

(( ${#dirs[@]} + ${#others[@]} == 0 )) && dirs=(.)

lsgroup() { (( $# )) || return 0; $LS --color=auto "${switches[@]}" -d -- "$@"; }

FIND=find; command -v gfind &>/dev/null && FIND=gfind
GREP=grep; command -v ggrep &>/dev/null && GREP=ggrep

# Entries look like "<type letter>/<name>", so patterns start with ^./
# Hides dotfiles and Windows clutter unless -a or -A was given.
function filter_out_hidden {
	if [[ -n $showhidden ]]; then cat; return; fi
	$GREP -zv \
		-e '^./\.' \
		-e '^./System Volume Information$' \
		-e '^./$RECYCLE\.BIN$' \
		-e '^./NTUSER\.DAT' \
		-e '^./ntuser\.dat' \
		-e '^./ntuser\.ini$'
}

for p in "${dirs[@]}"; do
	(
		cd -- "$p" || exit
		[[ $p != . && $p != ./ ]] && echo "$p:"

		# one find: each entry comes back as <type letter>/<name>, e.g. "d/sub"
		mapfile -d '' entries < <($FIND . -mindepth 1 -maxdepth 1 -printf '%y/%f\0' | filter_out_hidden)
		special=() under=() dir=() file=()
		for e in "${entries[@]}"; do
			t=${e:0:1} e=${e:2}
			case $t in
				d) if [[ $e == _* ]]; then under+=("$e"); else dir+=("$e"); fi ;;
				f) file+=("$e") ;;
				*) special+=("$e") ;;  # symlink, pipe, socket, device
			esac
		done

		lsgroup "${special[@]}"
		lsgroup "${under[@]}"
		lsgroup "${dir[@]}"
		lsgroup "${file[@]}"
		(( ${#dirs[@]} > 1 )) && echo
	)
done

lsgroup "${others[@]}"
