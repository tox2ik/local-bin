#!/usr/bin/env bash
# List the weeks (%W, Monday first) of a year: first - last day, month.
# Usage: weeks [year]   (default: current year)
# Week 00 (days before the first Monday) is shown as 52, last year's week.
# Output is cached in ~/.cache/weeks.<year>.

hash gdate &>/dev/null && DATE=gdate || DATE=date

if [[ $1 ]]; then
	[[ $1 =~ ^[0-9]{4}$ ]] || { echo "usage: ${0##*/} [year]" >&2; exit 2; }
	Y=$1
else
	printf -v Y '%(%Y)T' -1
fi
cache=~/.cache/weeks.$Y
[[ -s $cache ]] && exec cat "$cache"

# ~/.cache may be a symlink to a folder that does not exist yet
mkdir -p ~/.cache 2>/dev/null || mkdir -p "$(readlink ~/.cache)"

# One date call for all days: "<year> <week> <month> <day>" per line
for i in {0..365}; do echo "$Y-01-01 + $i days"; done |
$DATE -f - '+%Y %W %m %d' |
awk -v Y="$Y" '
	$1 != Y { next }                      # day 366 in a non-leap year
	!($2 in first) { first[$2] = $4; mon[$2] = $3; order[++n] = $2 }
	{ last[$2] = $4 }
	END {
		split("january february march april may june july august september october november december", name)
		for (k = 1; k <= n; k++) {
			w = order[k]; m = mon[w]
			printf "%s-%s w %s : %s - %s %s\n", Y, m, (w == "00" ? 52 : w), first[w], last[w], name[m + 0]
		}
	}' | tee "$cache.tmp" && mv "$cache.tmp" "$cache"
