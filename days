#!/usr/bin/env bash
# List the days of a year, or of a range: "<doy> <date> <month> <iso week> <weekday> " per line.
# Usage: days [year]       (default: current year)
#        days FROM TO      FROM inclusive, TO exclusive; a bare year means YYYY-01-01
# Output is cached in ~/.cache/days.<from>.<to>.

hash gdate &>/dev/null && DATE=gdate || DATE=date
usage() { echo "usage: ${0##*/} [year] | FROM TO" >&2; exit 2; }
day() { [[ $1 =~ ^[0-9]{4}$ ]] && echo "$1-01-01" || $DATE -d "$1" +%F 2>/dev/null || usage; }

case $# in
	0) printf -v Y '%(%Y)T' -1; from=$Y-01-01; to=$((Y + 1))-01-01 ;;
	1) [[ $1 =~ ^[0-9]{4}$ ]] || usage; from=$1-01-01; to=$(($1 + 1))-01-01 ;;
	2) from=$(day "$1") && to=$(day "$2") || exit 2 ;;
	*) usage ;;
esac

cache=~/.cache/days.$from.$to
[[ -s $cache ]] && exec cat "$cache"

# ~/.cache may be a symlink to a folder that does not exist yet
mkdir -p ~/.cache 2>/dev/null || mkdir -p "$(readlink ~/.cache)"

# Day count from UTC epochs, so DST cannot skip or repeat a day
n=$(( ($($DATE -u -d "$to" +%s) - $($DATE -u -d "$from" +%s)) / 86400 ))
(( n > 0 )) || exit 0

# One date call for all days
for ((i = 0; i < n; i++)); do echo "$from + $i days"; done |
$DATE -f - '+%j %Y-%m-%d %B %V %A ' | tee "$cache.tmp" && mv "$cache.tmp" "$cache"
